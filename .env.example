# Local development only. Copy to .env and choose a local database password.
DB_NAME=payment_db
DB_USERNAME=payment_user
DB_PASSWORD=local-payment-password
TRANSACTION_PORT=8080
PAYMENT_PORT=8081
FRAUD_PORT=8082
NOTIFICATION_PORT=8083
KAFKA_PORT=9092
# Match KAFKA_PORT when changing the host listener.
KAFKA_ADVERTISED_PORT=9092
MAILPIT_PORT=8025
