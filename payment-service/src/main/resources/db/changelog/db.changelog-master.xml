<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">
    <changeSet id="001-payment-schema" author="payment-service">
        <preConditions onFail="HALT" onFailMessage="Existing payment tables require an explicit migration before this baseline can be applied.">
            <not>
                <or>
                    <tableExists tableName="domain_events"/>
                    <tableExists tableName="transaction_read_model"/>
                </or>
            </not>
        </preConditions>
        <sqlFile path="001-payment-schema.sql" relativeToChangelogFile="true"/>
    </changeSet>
</databaseChangeLog>
